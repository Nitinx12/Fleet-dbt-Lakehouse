# =================================================
# Fleet dbt Warehouse — example environment variables
# Copy to .env and fill in real values. Never commit .env.
# =================================================

# --------------------------------------
# Environment Configuration
# --------------------------------------
TIME_FORMAT=%Y-%m-%d %H:%M:%S
TIMEZONE=Asia/Kolkata
ENVIRONMENT=development
LOG_LEVEL=INFO


# -------------------------------------------------
# Databricks configuration
# -------------------------------------------------
DATABRICKS_HOST=change-me
DATABRICKS_HTTP_PATH=change-me
DATABRICKS_CATALOG=fleet_marts
DATABRICKS_SCHEMA=marts
DATABRICKS_TOKEN=change-me

# -------------------------------------------------
# Databricks retry tuning        (warehouse capacity errors)
# DATABRICKS_MAX_ATTEMPTS        attempts per statement (1 disables retries)
# DATABRICKS_RETRY_BASE_SECONDS  first backoff delay, doubles up to 60s
# JOB_RETRY_BACKOFF_SECONDS      wait before run_jobs retries a failed job
# -------------------------------------------------
DATABRICKS_MAX_ATTEMPTS=4
DATABRICKS_RETRY_BASE_SECONDS=5
JOB_RETRY_BACKOFF_SECONDS=30

# --------------------------------------
# Publish_marts tuning     (SQL connector bulk load)
# PUBLISH_MART_WORKERS     marts published at the same time
# PUBLISH_WORKERS          parallel statements + staging tables per mart
# PUBLISH_WORKER_MIN_ROWS  tables smaller than this load on one connection
# --------------------------------------
PUBLISH_MAX_PARAMS=10000
PUBLISH_MART_WORKERS=3
PUBLISH_WORKERS=6
PUBLISH_WORKER_MIN_ROWS=50000
PUBLISH_FETCH_SIZE=10000
PUBLISH_MERGE_MAX_SQL_CHARS=4000000


# ----------------------------------------------------
# MongoDB configuration
# ----------------------------------------------------
MONGO_URI=mongodb://localhost:27017/fleet_operations
MONGO_DB_NAME=fleet_operations
MONGO_PORT=27017

# ----------------------------------------------------
# MySQL configuration (prefer a read-only user in live mode)
# ----------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=fleet_registry
MYSQL_SERVER_TZ=UTC
MYSQL_SSL_MODE=PREFERRED

# ----------------------------------------------------
# Serving Postgres configuration
# ----------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
PG_DBNAME=fleet_warehouse

# ----------------------------------------------------
# Airflow configuration
# ----------------------------------------------------
AIRFLOW_HOST=localhost
AIRFLOW_PORT=8080
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_ADMIN_USERNAME=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=change-me
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW__CORE__FERNET_KEY=print("Run 'python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'' to generate a new key")
DBT_TARGET=dev
MYSQL_POOL_SLOTS=4
MONGO_POOL_SLOTS=3

# ----------------------------------------------------
# Gmail Alert / SMTP configuration
# ----------------------------------------------------
ALERT_EMAIL_TO=yourmail.com
ALERT_EMAIL_FROM=yourmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourmail.com
SMTP_PASSWORD=change-me
SMTP_MAIL_FROM=yourmail.com
SMTP_STARTTLS=True
SMTP_SSL=False
ALERT_WEBHOOK_URL=
# Airflow SMTP (maps to airflow.cfg [smtp])
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=yourmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=change-me
AIRFLOW__SMTP__SMTP_MAIL_FROM=yourmail.com
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False

