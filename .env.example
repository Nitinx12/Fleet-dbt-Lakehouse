# =================================================
# Fleet dbt Warehouse — example environment variables
# Copy to .env and fill in real values. Never commit .env.
# =================================================

# --------------------------------------
# Environment configuration
# --------------------------------------
TIME_FORMAT=%Y-%m-%d %H:%M:%S
TIMEZONE=Asia/Kolkata
ENVIRONMENT=development
LOG_LEVEL=INFO

# Source connectivity: live | csv | fixture
SOURCE_MODE=live

# --------------------------------------
# Databricks (dbt uses OAuth service principal)
# --------------------------------------
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<id>
# Personal access token used by utils/connection.py — required, utils refuses to import without it
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# dbt dev schema / CI schema prefix
DBT_DEV_SCHEMA=dev_yourname
DBT_SCHEMA_PREFIX=dev_yourname

# PII hashing salt used by the dbt pii_hash macro (prod fails closed if unset)
PII_SALT=

# --------------------------------------
# MongoDB source (live mode)
# --------------------------------------
MONGO_URI=mongodb://localhost:27017/fleet_operations
MONGO_DB_NAME=fleet_operations
MONGO_PORT=27017

# --------------------------------------
# MySQL source (live mode — prefer a read-only user)
# --------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Host port for the docker-compose MySQL service (container always listens on 3306)
MYSQL_HOST_PORT=13306
MYSQL_USER=fleet_ro
MYSQL_PASSWORD=
MYSQL_DATABASE=fleet_registry
MYSQL_SERVER_TZ=UTC
MYSQL_SSL_MODE=PREFERRED

# --------------------------------------
# Pipeline Postgres (bronze/silver/gold + audit, control)
# --------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=fleet
PG_PASSWORD=fleet
PG_DBNAME=fleet_warehouse
# optional: managed providers like Neon only
PG_SSLMODE=
PG_CHANNEL_BINDING=

# --------------------------------------
# Airflow metadata database (placeholders only)
# --------------------------------------
AIRFLOW_PG_HOST=localhost
AIRFLOW_PG_USER=airflow
AIRFLOW_PG_PASSWORD=
AIRFLOW_PG_DB=airflow

# --------------------------------------
# Failure alerts (optional)
# --------------------------------------
ALERT_WEBHOOK_URL=
