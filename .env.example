# =================================================
# Fleet dbt Lakehouse — example environment variables
# Copy to .env and fill in real values. Never commit .env.
# =================================================

# --------------------------------------
# Environment configuration
# --------------------------------------
TIME_FORMAT=%Y-%m-%d %H:%M:%S
TIMEZONE=Asia/Kolkata
ENVIRONMENT=development
LOG_LEVEL=INFO

# Source connectivity: live | csv | fixture
SOURCE_MODE=live

# --------------------------------------
# Databricks (dbt uses OAuth service principal)
# --------------------------------------
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<id>
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# dbt dev schema / CI schema prefix
DBT_DEV_SCHEMA=dev_yourname
DBT_SCHEMA_PREFIX=dev_yourname

# PII hashing salt (DBT_ENV_SECRET_ prefix keeps it out of dbt logs)
DBT_ENV_SECRET_PII_SALT=

# --------------------------------------
# MongoDB source (live mode)
# --------------------------------------
MONGO_URI=mongodb://localhost:27017/fleet_operations
MONGO_DB_NAME=fleet_operations
MONGO_PORT=27017

# --------------------------------------
# MySQL source (live mode — prefer a read-only user)
# --------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=fleet_ro
MYSQL_PASSWORD=
MYSQL_DATABASE=fleet_registry
MYSQL_SERVER_TZ=UTC
MYSQL_SSL_MODE=PREFERRED

# --------------------------------------
# Serving Postgres
# --------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=fleet
PG_PASSWORD=fleet
PG_DBNAME=fleet_serving

# --------------------------------------
# Dagster run storage (long-running mode only)
# --------------------------------------
DAGSTER_PG_HOST=localhost
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=
DAGSTER_PG_DB=dagster

# --------------------------------------
# Failure alerts (optional)
# --------------------------------------
ALERT_WEBHOOK_URL=
